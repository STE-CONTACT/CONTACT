# Copier ce fichier en « .env » puis lancer : npm run start:prod
PORT=3443
# Certificat HTTPS (voir INSTALLATION-RESEAU.md, étape 4)
HTTPS_KEY=certs/serveur-key.pem
HTTPS_CERT=certs/serveur.pem
TZ_ENTREPRISE=Africa/Tunis
# Mot de passe du compte admin initial (premier démarrage uniquement)
# ADMIN_PASSWORD=ChangerCeMotDePasse#2026
# Emails (facultatif)
# SMTP_HOST=smtp.entreprise.tn
# SMTP_PORT=587
# SMTP_USER=autorisations@entreprise.tn
# SMTP_PASS=
# SMTP_FROM=autorisations@entreprise.tn
